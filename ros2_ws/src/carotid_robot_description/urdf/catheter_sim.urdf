<?xml version="1.0"?>
<robot name="tracking_arm">

  <!--
    Planar tracking arm and active localized point in Gazebo.
  -->

  <link name="world"/>

  <!-- ================================================================
       ARM SYSTEM
       ================================================================ -->
  <joint name="j_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder length="0.08" radius="0.08"/></geometry>
      <material name="dark_metal"><color rgba="0.15 0.15 0.15 1.0"/></material>
    </visual>
    <inertial><mass value="10.0"/><inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/></inertial>
  </link>
  <gazebo reference="base_link"><material>Gazebo/DarkGrey</material></gazebo>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100" velocity="3.0"/>
  </joint>
  <link name="link_1">
    <visual>
      <origin xyz="0.20 0 0.0" rpy="0 1.5707963 0"/>
      <geometry><cylinder length="0.40" radius="0.035"/></geometry>
      <material name="white"><color rgba="0.95 0.95 0.95 1.0"/></material>
    </visual>
    <inertial><mass value="1.5"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <gazebo reference="link_1"><material>Gazebo/White</material></gazebo>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0.40 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.79253" upper="2.79253" effort="80" velocity="3.0"/>
  </joint>
  <link name="link_2">
    <visual>
      <origin xyz="0.175 0 0.0" rpy="0 1.5707963 0"/>
      <geometry><cylinder length="0.35" radius="0.025"/></geometry>
      <material name="white"/>
    </visual>
    <inertial><mass value="0.8"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <gazebo reference="link_2"><material>Gazebo/White</material></gazebo>

  <joint name="j_ee" type="fixed">
    <parent link="link_2"/>
    <child link="ee_link"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
  </joint>
  <link name="ee_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="cyan"><color rgba="0.0 1.0 1.0 1.0"/></material>
    </visual>
    <inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <gazebo reference="ee_link"><material>Gazebo/Cyan</material></gazebo>

  <!-- ================================================================
       ACTIVE TARGET POINT SYSTEM (RED SPHERE IN GAZEBO)
       ================================================================ -->
  <joint name="target_x_joint" type="prismatic">
    <parent link="world"/>
    <child link="target_x_link"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="10"/>
  </joint>
  <link name="target_x_link">
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="target_y_joint" type="prismatic">
    <parent link="target_x_link"/>
    <child link="target_point"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="10"/>
  </joint>
  <link name="target_point">
    <visual>
      <geometry><sphere radius="0.02"/></geometry>
      <material name="bright_red"><color rgba="1.0 0.0 0.0 1.0"/></material>
    </visual>
    <inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <gazebo reference="target_point">
    <material>
      <ambient>1.0 0.0 0.0 1.0</ambient>
      <diffuse>1.0 0.0 0.0 1.0</diffuse>
      <emissive>1.0 0.0 0.0 1.0</emissive>
    </material>
  </gazebo>

  <!-- ================================================================
       ROS2 CONTROL
       ================================================================ -->
  <ros2_control name="ArmSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="target_x_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.45</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="target_y_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find carotid_bringup)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
