<?xml version="1.0"?>
<!--
  carotid_arm.urdf
  ==================
  Simplified 5-DOF robotic arm for carotid catheterization simulation.
  *UPGRADED VISUALS FOR SOTA MEDICAL DEMONSTRATION*

  Kinematic chain:
    world → base_link
    base_link → joint_base_rot (Z yaw) → link_shoulder
    link_shoulder → joint_shoulder (Y pitch) → link_upper_arm
    link_upper_arm → joint_elbow (Y pitch) → link_forearm
    link_forearm → joint_wrist_pitch (Y) → link_wrist
    link_wrist → joint_wrist_roll (Z) → link_end_effector
    link_end_effector → joint_probe_tip (fixed) → probe_tip
-->
<robot name="carotid_arm">

  <!-- ══════════════════════════════════════════
       Materials
  ══════════════════════════════════════════ -->
  <material name="medical_white"> <color rgba="0.95 0.95 0.95 1"/> </material>
  <material name="medical_blue">  <color rgba="0.1 0.5 0.8 1"/>    </material>
  <material name="medical_metal"> <color rgba="0.7 0.7 0.75 1"/>   </material>
  <material name="patient_skin">  <color rgba="0.9 0.75 0.65 1"/>  </material>
  <material name="table_blue">    <color rgba="0.2 0.3 0.4 1"/>    </material>
  <material name="probe_dark">    <color rgba="0.15 0.15 0.15 1"/> </material>
  <material name="probe_active">  <color rgba="0.0 0.8 1.0 1"/>    </material>

  <link name="world"/>

  <!-- ══════════════════════════════════════════
       Robot Base
  ══════════════════════════════════════════ -->
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════
       Environment: Operating Table & Patient
  ══════════════════════════════════════════ -->
  <joint name="base_to_table" type="fixed">
    <parent link="base_link"/>
    <child link="operating_table"/>
    <origin xyz="0.4 0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="operating_table">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.6 1.8 0.04"/></geometry>
      <material name="table_blue"/>
    </visual>
    <inertial>
      <mass value="50.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="10.0" ixy="0" ixz="0" iyy="10.0" iyz="0" izz="10.0"/>
    </inertial>
  </link>
  <gazebo reference="operating_table">
    <material>Gazebo/Blue</material>
  </gazebo>

  <joint name="table_to_patient" type="fixed">
    <parent link="operating_table"/>
    <child link="patient_neck"/>
    <origin xyz="-0.15 0.0 0.08" rpy="1.5708 0 0"/>
  </joint>

  <link name="patient_neck">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://carotid_robot_description/meshes/carotid.stl" scale="0.005 0.005 0.005"/>
      </geometry>
      <material name="patient_skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://carotid_robot_description/meshes/carotid.stl" scale="0.005 0.005 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>
  </link>
  <gazebo reference="patient_neck">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- ══════════════════════════════════════════
       Robot Base
  ══════════════════════════════════════════ -->


  <link name="base_link">
    <visual>
      <!-- Pedestal base -->
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.12"/></geometry>
      <material name="medical_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.12"/></geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ══════════════════════════════════════════
       Joint 0: Base rotation (yaw, Z)
  ══════════════════════════════════════════ -->
  <joint name="joint_base_rot" type="revolute">
    <parent link="base_link"/>
    <child link="link_shoulder"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="80" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_shoulder">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder length="0.08" radius="0.06"/></geometry>
      <material name="medical_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder length="0.08" radius="0.06"/></geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.04"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- ══════════════════════════════════════════
       Joint 1: Shoulder pitch (Y)
  ══════════════════════════════════════════ -->
  <joint name="joint_shoulder" type="revolute">
    <parent link="link_shoulder"/>
    <child link="link_upper_arm"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="80" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_upper_arm">
    <visual>
      <!-- Joint Cap -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.13" radius="0.055"/></geometry>
      <material name="medical_blue"/>
    </visual>
    <visual>
      <!-- Arm link -->
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder length="0.3" radius="0.045"/></geometry>
      <material name="medical_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder length="0.3" radius="0.045"/></geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.15"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ══════════════════════════════════════════
       Joint 2: Elbow pitch (Y)
  ══════════════════════════════════════════ -->
  <joint name="joint_elbow" type="revolute">
    <parent link="link_upper_arm"/>
    <child link="link_forearm"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="60" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_forearm">
    <visual>
      <!-- Joint Cap -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.11" radius="0.045"/></geometry>
      <material name="medical_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder length="0.3" radius="0.035"/></geometry>
      <material name="medical_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder length="0.3" radius="0.035"/></geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0.15"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <!-- ══════════════════════════════════════════
       Joint 3: Wrist pitch (Y)
  ══════════════════════════════════════════ -->
  <joint name="joint_wrist_pitch" type="revolute">
    <parent link="link_forearm"/>
    <child link="link_wrist"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link_wrist">
    <visual>
      <!-- Joint Cap -->
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder length="0.08" radius="0.035"/></geometry>
      <material name="medical_blue"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.025"/></geometry>
      <material name="medical_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.025"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ══════════════════════════════════════════
       Joint 4: Wrist roll (Z)
  ══════════════════════════════════════════ -->
  <joint name="joint_wrist_roll" type="revolute">
    <parent link="link_wrist"/>
    <child link="link_end_effector"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="30" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link_end_effector">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.02"/></geometry>
      <material name="medical_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0.025"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ══════════════════════════════════════════
       Joint 5: Probe tip (fixed)
  ══════════════════════════════════════════ -->
  <joint name="joint_probe_tip" type="fixed">
    <parent link="link_end_effector"/>
    <child link="probe_tip"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- This represents the active face of the ultrasound probe -->
  <link name="probe_tip">
    <visual>
      <!-- Probe Head -->
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.08 0.03 0.04"/></geometry>
      <material name="probe_dark"/>
    </visual>
    <visual>
      <!-- Probe Active Sensor Array -->
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry><box size="0.06 0.01 0.01"/></geometry>
      <material name="probe_active"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><box size="0.08 0.03 0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>


  <!-- ══════════════════════════════════════════
       ros2_control configuration for Gazebo Harmonic
  ══════════════════════════════════════════ -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="joint_base_rot">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_shoulder">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.5</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_elbow">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">1.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_wrist_pitch">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">-0.5</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_wrist_roll">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ══════════════════════════════════════════
       Gazebo harmonic plugin
  ══════════════════════════════════════════ -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find carotid_bringup)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Colors for Gazebo -->
  <gazebo reference="operating_table"> <material>Gazebo/Grey</material> </gazebo>
  <gazebo reference="patient_neck"> <material>Gazebo/White</material> </gazebo>
  <gazebo reference="base_link"> <material>Gazebo/Grey</material> </gazebo>
  <gazebo reference="link_shoulder"> <material>Gazebo/White</material> </gazebo>
  <gazebo reference="link_upper_arm"> <material>Gazebo/White</material> </gazebo>
  <gazebo reference="link_forearm"> <material>Gazebo/White</material> </gazebo>
  <gazebo reference="link_wrist"> <material>Gazebo/White</material> </gazebo>
  <gazebo reference="link_end_effector"> <material>Gazebo/Grey</material> </gazebo>
  <gazebo reference="probe_tip"> <material>Gazebo/DarkGrey</material> </gazebo>

</robot>
